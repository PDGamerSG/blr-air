# Run python -m blr_air init to generate private identities automatically.
# Keep the same AGENT_SEED_PHRASE when moving to a server.
AGENT_SEED_PHRASE=
CALLER_SEED=

# Optional. Without it, the documented English prompts use local parsing.
ASI1_API_KEY=
ASI1_BASE_URL=https://api.asi1.ai/v1

# Optional speech-to-text / text-to-speech for CLI and website.
SARVAM_API_KEY=
GOOGLE_PLACES_API_KEY=
# Public HTTPS origin when serving behind a reverse proxy, e.g. https://air.example.com
PUBLIC_ORIGIN=
WEB_PORT=8082

# Set after python -m blr_air doctor prints your agent's public address.
BLR_AIR_ADDRESS=
AGENT_PORT=8001
DATA_DIR=data
